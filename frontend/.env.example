# Where the Connect backend (../backend) is reachable FROM THIS SERVER. Pages fetch on the server, so this can be
# an internal address (e.g. http://connect:3000 inside Docker). Default: http://localhost:3000
CONNECT_API_URL=http://localhost:3000

# The public address of the Connect app, used for links visitors click (Join, Sign in, Rules, Privacy...).
# Default: same as CONNECT_API_URL
NEXT_PUBLIC_CONNECT_APP_URL=http://localhost:3000

# Seconds to cache API responses before re-fetching. Default: 60
REVALIDATE_SECONDS=60
