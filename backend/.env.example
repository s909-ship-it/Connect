# Copy to .env.local and fill in. Nothing here is needed to try the app locally with sample people.

# Where the app is reachable. Must match the redirect URL in your LinkedIn app:
#   <APP_URL>/api/auth/google/callback and <APP_URL>/api/auth/linkedin/callback
APP_URL=http://localhost:3000

# Long random string. Required in production. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Google sign-in: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
# A student who signs in with a Google account on COLLEGE_EMAIL_DOMAIN is verified straight away.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn developer app with the "Sign In with LinkedIn using OpenID Connect" product added.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Connect runs many colleges at once. Each student's college comes from the domain of an email they prove.
# These two only name the first college when an older single-college database is upgraded. Optional.
COLLEGE_EMAIL_DOMAIN=
COLLEGE_NAME=

# Site admins: verified sign-in emails, comma separated. They open new colleges and pick each college's admins.
ADMIN_EMAILS=

# Email for verification codes and inbox alerts. Set ONE of these. Without either, codes only work in
# development (printed in the server log), and in production students verify by signing in with a
# Google account on COLLEGE_EMAIL_DOMAIN.
# Easiest: a Gmail app password (myaccount.google.com/apppasswords), written as
#   SMTP_URL=smtps://yourname%40gmail.com:the16letterpassword@smtp.gmail.com:465
SMTP_URL=
# Or resend.com, which needs a domain you own.
RESEND_API_KEY=
MAIL_FROM=Connect <yourname@gmail.com>

# Shown on the privacy page as the address for questions. Optional.
CONTACT_EMAIL=

# Voice and video calls work on most Wi-Fi with no setup. On mobile data and strict networks they need a
# TURN relay. Set ONE of these. Cloudflare is recommended (free tier: 1,000 GB a month):
#   dash.cloudflare.com > Realtime (or Calls) > TURN Server > Create
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or Metered (metered.ca > TURN Server): your app domain, e.g. yourapp.metered.live, and its API key.
METERED_DOMAIN=
METERED_API_KEY=
# Or a fixed relay of your own. Comma-separate several URLs, e.g.
#   TURN_URLS=turn:relay.example.com:3478,turns:relay.example.com:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Push alerts (calls ring and messages arrive with Connect closed). Make once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Gemini API key from Google AI Studio (aistudio.google.com).
GEMINI_API_KEY=
GEMINI_MODEL=
# Used when the main model is overloaded. Comma separated. Defaults to gemini-3.5-flash.
GEMINI_FALLBACK_MODEL=

# Optional. Lets the AI proof check read more GitHub repos an hour (60 requests an hour without it, 5,000 with it;
# one check uses about 5 per repo). A fine-grained token with no extra permissions is enough:
# github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional. Defaults to ./data/connect.db
DATABASE_PATH=

# Public showcase API (app/api/public/*). Read-only, public data only. Browsers from any origin may read it unless
# this names one origin, e.g. https://showcase.yourcollege.in. The showcase fetches on its server, so it works either way.
PUBLIC_API_ORIGIN=
# The showcase's public address. Lets its account menu (avatar, top right) read who is signed in and sign out.
# Needs the showcase and Connect on the same site (e.g. showcase.example.in + app.example.in). Any localhost port works in development.
SHOWCASE_URL=
