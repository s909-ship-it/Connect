# Two apps, two env files. This one is only a map; copy the real ones:
#   cp backend/.env.example  backend/.env.local     (Connect: sign-in keys, mail, calls, push, AI...)
#   cp frontend/.env.example frontend/.env.local    (showcase: where the backend is)
# Nothing in either is needed to try both locally with the sample data.

# ---- frontend/.env.local ----
CONNECT_API_URL=http://localhost:3000          # backend address as seen from the showcase server
NEXT_PUBLIC_CONNECT_APP_URL=http://localhost:3000  # backend address as seen by visitors (Join, Rules, Privacy links)
REVALIDATE_SECONDS=60                           # how long API responses are cached

# ---- backend/.env.local (new in this project) ----
PUBLIC_API_ORIGIN=                              # optional: restrict browser CORS on /api/public/* to one origin
# backend: the showcase's address, so its account menu (top right) can read who is signed in. Same site as Connect.
SHOWCASE_URL=

# ---- backend/.env.local (from Connect, unchanged; see backend/.env.example for how to get each) ----
APP_URL=http://localhost:3000
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
COLLEGE_EMAIL_DOMAIN=
COLLEGE_NAME=
ADMIN_EMAILS=
SMTP_URL=
RESEND_API_KEY=
MAIL_FROM=
CONTACT_EMAIL=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
METERED_DOMAIN=
METERED_API_KEY=
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GITHUB_TOKEN=
DATABASE_PATH=
